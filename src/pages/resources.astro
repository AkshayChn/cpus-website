---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';

const entry = await getEntry('pages', 'resources');
if (!entry) throw new Error('Missing resources page content');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <Container class="py-10 sm:py-14">
    <article class="mx-auto max-w-3xl">
      <header class="border-b border-rule pb-6">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-highlight">Library</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          {entry.data.title}
        </h1>
        {entry.data.description && (
          <p class="mt-4 text-lg leading-relaxed text-muted">{entry.data.description}</p>
        )}
      </header>
      <div class="prose-cpus mt-8">
        <Content />
      </div>
    </article>
  </Container>
</BaseLayout>
