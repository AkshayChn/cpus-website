---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you were looking for is not here.">
  <Container class="py-20 sm:py-28">
    <div class="mx-auto max-w-xl text-center">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-highlight">404</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        This page is not here.
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        The link may be old, or the page may still be under construction.
      </p>
      <a
        href={url('/')}
        class="mt-8 inline-flex rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-paper hover:opacity-90"
      >
        Back to home
      </a>
    </div>
  </Container>
</BaseLayout>
