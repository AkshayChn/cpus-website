---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import {
  formatDate,
  getArticles,
  getArticlesBySeries,
  getRelatedArticles,
  getSeriesMap,
  readingTime,
} from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const seriesMap = await getSeriesMap();
const series = article.data.series ? seriesMap.get(article.data.series.id) : undefined;
const { Content, headings } = await render(article);
const related = await getRelatedArticles(article, 3);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const seriesArticles = article.data.series
  ? await getArticlesBySeries(article.data.series.id)
  : [];
const index = seriesArticles.findIndex((entry) => entry.id === article.id);
const previous = index > 0 ? seriesArticles[index - 1] : undefined;
const next = index >= 0 && index < seriesArticles.length - 1 ? seriesArticles[index + 1] : undefined;
---

<BaseLayout
  title={article.data.title}
  description={article.data.summary}
  image={article.data.cover?.src}
  type="article"
>
  <Container class="py-8 sm:py-12">
    <article class="mx-auto max-w-4xl">
      <header class="mx-auto max-w-3xl text-center">
        <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-highlight">
          {series ? (
            <a href={url(`/series/${series.id}/`)} class="hover:underline">{series.data.title}</a>
          ) : (
            <span>CPUS</span>
          )}
          <span class="text-rule">/</span>
          <time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time>
        </div>

        <h1
          class="mt-4 text-3xl font-semibold leading-[1.2] tracking-tight text-ink sm:text-4xl lg:text-5xl"
          lang={article.data.language === 'kn' ? 'kn' : undefined}
        >
          {article.data.title}
        </h1>

        <p
          class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted"
          lang={article.data.language === 'kn' ? 'kn' : undefined}
        >
          {article.data.summary}
        </p>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-3 text-sm text-muted">
          <span>{article.data.author}</span>
          <span class="text-rule">·</span>
          <span>{readingTime(article)} min read</span>
          {article.data.language === 'kn' && (
            <>
              <span class="text-rule">·</span>
              <span lang="kn">ಕನ್ನಡ</span>
            </>
          )}
        </div>
      </header>

      {article.data.cover && (
        <figure class="mt-8 overflow-hidden rounded-2xl bg-accent-soft sm:mt-10">
          <Image
            src={article.data.cover}
            alt={article.data.coverAlt ?? ''}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1024px) 1000px, 100vw"
            class="aspect-[16/9] w-full object-cover"
            loading="eager"
          />
        </figure>
      )}

      {toc.length > 1 && (
        <nav
          class="mx-auto mt-10 max-w-2xl rounded-xl border border-rule bg-surface p-5"
          aria-label="Table of contents"
          lang={article.data.language === 'kn' ? 'kn' : undefined}
        >
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">In this article</p>
          <ol class="mt-3 space-y-1.5 text-sm">
            {toc.map((heading) => (
              <li class:list={[heading.depth === 3 && 'pl-4']}>
                <a href={`#${heading.slug}`} class="text-ink hover:text-accent">{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose-cpus mt-10 sm:mt-12" lang={article.data.language === 'kn' ? 'kn' : 'en'}>
        <Content />
      </div>

      {(previous || next) && (
        <nav class="mx-auto mt-14 max-w-3xl border-t border-rule pt-6" aria-label="More from this series">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">More from this series</p>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {previous && (
              <a href={url(`/articles/${previous.id}/`)} class="rounded-lg border border-rule p-4 hover:border-accent">
                <span class="text-xs text-muted">Previous</span>
                <span
                  class="mt-1 block text-sm font-medium text-ink"
                  lang={previous.data.language === 'kn' ? 'kn' : undefined}
                >
                  {previous.data.title}
                </span>
              </a>
            )}
            {next && (
              <a href={url(`/articles/${next.id}/`)} class="rounded-lg border border-rule p-4 text-right hover:border-accent sm:col-start-2">
                <span class="text-xs text-muted">Next</span>
                <span
                  class="mt-1 block text-sm font-medium text-ink"
                  lang={next.data.language === 'kn' ? 'kn' : undefined}
                >
                  {next.data.title}
                </span>
              </a>
            )}
          </div>
        </nav>
      )}
    </article>
  </Container>

  {related.length > 0 && (
    <Container class="py-10 sm:py-14">
      <div class="mb-6 border-b border-rule pb-3">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-highlight">Keep reading</p>
        <h2 class="mt-1 text-2xl font-semibold tracking-tight text-ink">More to read</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((entry) => (
          <ArticleCard
            article={entry}
            series={entry.data.series ? seriesMap.get(entry.data.series.id) : undefined}
          />
        ))}
      </div>
    </Container>
  )}
</BaseLayout>
