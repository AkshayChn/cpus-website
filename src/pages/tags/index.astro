---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { getTags } from '../../lib/content';
import { url } from '../../lib/url';

const tags = await getTags();
---

<BaseLayout title="Tags" description="Browse CPUS articles by topic.">
  <Container class="py-10 sm:py-14">
    <header class="max-w-2xl">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-highlight">Browse</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Tags</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">Browse articles by topic.</p>
    </header>

    {tags.length > 0 ? (
      <div class="mt-8 flex flex-wrap gap-2">
        {tags.map(({ tag, count }) => (
          <a
            href={url(`/tags/${tag}/`)}
            aria-label={`#${tag}, ${count} ${count === 1 ? 'article' : 'articles'}`}
            class="inline-flex items-center gap-2 rounded-full border border-rule px-3.5 py-2 text-sm text-ink transition-colors hover:border-accent hover:text-accent"
          >
            <span>#{tag}</span>
            <span class="text-xs tabular-nums text-muted">{count}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-8 text-muted">No tags yet.</p>
    )}
  </Container>
</BaseLayout>
