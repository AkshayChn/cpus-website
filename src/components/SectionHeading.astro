---
import { url } from '../lib/url';

interface Props {
  title: string;
  kicker?: string;
  href?: string;
  linkLabel?: string;
}

const { title, kicker, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-3 border-b border-rule pb-3">
  <div>
    {kicker && (
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-highlight">{kicker}</p>
    )}
    <h2 class="mt-1 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h2>
  </div>
  {href && (
    <a href={url(href)} class="text-sm font-medium text-accent hover:underline">
      {linkLabel} <span aria-hidden="true">→</span>
    </a>
  )}
</div>
