---
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/95 backdrop-blur">
  <Container class="flex h-16 items-center justify-between gap-4">
    <a href={url('/')} class="flex min-w-0 items-center gap-3" aria-label={`${site.name} home`}>
      <span class="text-xl font-bold tracking-tight text-ink">CPUS</span>
      <span class="hidden min-w-0 truncate border-l border-rule pl-3 text-[0.7rem] leading-tight text-muted sm:block">
        Center for Public<br />Understanding of Science
      </span>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-muted lg:flex" aria-label="Primary">
      {site.nav.map((item) => (
        <a
          href={url(item.href)}
          class="transition-colors hover:text-accent"
          aria-current={Astro.url.pathname === url(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <details class="group relative lg:hidden">
        <summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border border-rule text-muted [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Open menu</span>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <div class="absolute right-0 top-12 w-56 rounded-xl border border-rule bg-surface p-2 shadow-xl">
          <nav class="flex flex-col" aria-label="Mobile">
            {site.nav.map((item) => (
              <a
                href={url(item.href)}
                class="rounded-lg px-3 py-2.5 text-sm font-medium text-ink hover:bg-accent-soft"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </details>
    </div>
  </Container>
</header>
