---
import Container from './Container.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="no-print mt-20 border-t border-rule bg-surface">
  <Container class="grid gap-10 py-12 md:grid-cols-[1.5fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href={url('/')} class="text-lg font-bold tracking-tight">CPUS</a>
      <p class="mt-3 text-sm leading-relaxed text-muted">{site.description}</p>
      <p class="mt-4 text-xs text-muted">
        This is a preview of the new website. Content and structure are still being built.
      </p>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">Explore</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {site.footer.map((item) => (
          <li>
            <a href={url(item.href)} class="text-ink hover:text-accent">{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">Contact</h2>
      <address class="mt-4 space-y-1 text-sm not-italic leading-relaxed text-muted">
        {site.address.lines.map((line) => <span class="block">{line}</span>)}
      </address>
      <p class="mt-3 text-sm">
        <a href={`mailto:${site.email}`} class="text-ink hover:text-accent">{site.email}</a>
      </p>
      <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <a href={site.social.youtube} class="text-muted hover:text-accent" rel="me">YouTube</a>
        <a href={site.social.instagram} class="text-muted hover:text-accent" rel="me">Instagram</a>
        <a href={site.social.facebook} class="text-muted hover:text-accent" rel="me">Facebook</a>
      </div>
    </div>
  </Container>

  <div class="border-t border-rule">
    <Container class="flex flex-wrap items-center justify-between gap-2 py-5 text-xs text-muted">
      <p>© {year} {site.fullName}</p>
      <p>Preview build</p>
    </Container>
  </div>
</footer>
