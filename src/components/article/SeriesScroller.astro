---
import { Image } from 'astro:assets';
import type { Article, Series } from '../../lib/content';
import { formatDate, readingTime } from '../../lib/content';
import { url } from '../../lib/url';

interface Props {
  articles: Article[];
  series?: Series;
  title: string;
  kicker: string;
  linkHref?: string;
  linkLabel?: string;
}

const { articles, series, title, kicker, linkHref, linkLabel = 'View all' } = Astro.props;
---

{articles.length > 0 && (
  <section
    class="mt-14 border-t border-rule pt-8"
    aria-labelledby="end-title"
    data-article-end
  >
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-highlight">{kicker}</p>
        <h2 id="end-title" class="mt-1 text-2xl font-semibold tracking-tight text-ink">{title}</h2>
      </div>
      {linkHref && (
        <a href={url(linkHref)} class="text-sm font-medium text-accent hover:underline">
          {linkLabel} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <div class="relative mt-5">
      <div
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        tabindex="0"
        role="region"
        aria-label="More articles"
      >
        {articles.map((entry) => {
          const isPortrait = entry.data.cover
            ? entry.data.cover.height > entry.data.cover.width
            : false;

          return (
            <article class="group w-[15.5rem] shrink-0 snap-start sm:w-[17rem]">
              <a href={url(`/articles/${entry.id}/`)} class="block">
                <div class="overflow-hidden rounded-xl bg-accent-soft">
                  {entry.data.cover ? (
                    <Image
                      src={entry.data.cover}
                      alt={entry.data.coverAlt ?? ''}
                      widths={[300, 500]}
                      sizes="(min-width: 640px) 272px, 248px"
                      class:list={[
                        'aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]',
                        isPortrait && 'object-top',
                      ]}
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex aspect-[4/3] items-center justify-center bg-accent-soft p-4 text-center">
                      <span
                        class="text-sm font-semibold text-accent"
                        lang={entry.data.language === 'kn' ? 'kn' : undefined}
                      >
                        {entry.data.title}
                      </span>
                    </div>
                  )}
                </div>

                <div class="mt-3">
                  <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-accent">
                    {series ? series.data.title : 'CPUS'}
                  </p>
                  <h3
                    class="mt-1 line-clamp-3 text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-accent"
                    lang={entry.data.language === 'kn' ? 'kn' : undefined}
                  >
                    {entry.data.title}
                  </h3>
                  <p class="mt-1 text-xs text-muted">
                    <time datetime={entry.data.publishedAt.toISOString()}>
                      {formatDate(entry.data.publishedAt)}
                    </time>
                    <span class="mx-1.5 text-rule">·</span>
                    {readingTime(entry)} min read
                  </p>
                </div>
              </a>
            </article>
          );
        })}
      </div>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-paper to-transparent"
        aria-hidden="true"
      ></div>
    </div>
  </section>
)}
