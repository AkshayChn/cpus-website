---
import type { Article, Series } from '../../lib/content';
import { url } from '../../lib/url';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: Article;
  series?: Series;
  seriesArticles: Article[];
  toc: TocHeading[];
}

const { article, series, seriesArticles, toc } = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const seriesIndex = seriesArticles.findIndex((entry) => entry.id === article.id);
const hasSeriesList = seriesArticles.length > 1 && seriesIndex >= 0;
---

<aside class="no-print hidden lg:block" aria-label="Reading aids">
  <div class="sticky top-24 max-h-[calc(100svh-7rem)] overflow-y-auto overscroll-contain pr-1">
    <div>
      <div class="flex items-baseline justify-between gap-3">
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-muted">Reading</p>
        <span class="text-xs tabular-nums text-muted" data-progress-label>0%</span>
      </div>
      <div class="mt-2 h-0.5 overflow-hidden rounded-full bg-rule">
        <div class="h-full w-0 bg-accent" data-progress-bar></div>
      </div>
    </div>

    {toc.length > 0 && (
      <nav class="mt-8" aria-label="Contents">
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-muted">Contents</p>
        <ol class="mt-3 space-y-0.5">
          {toc.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                data-toc-link={heading.slug}
                class:list={[
                  'toc-link block border-l-2 border-transparent py-1 text-sm leading-snug text-muted transition-colors hover:text-ink',
                  heading.depth === 3 ? 'pl-6' : 'pl-3',
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    {series && (
      <div class="mt-8 border-t border-rule pt-6">
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-muted">From the series</p>
        <a
          href={url(`/series/${series.id}/`)}
          class="mt-2 block text-sm font-semibold leading-snug text-ink hover:text-accent"
        >
          {series.data.title}
        </a>
        <p class="mt-1 text-xs text-muted">
          {hasSeriesList
            ? `Part ${seriesIndex + 1} of ${seriesArticles.length}`
            : `${seriesArticles.length} article${seriesArticles.length === 1 ? '' : 's'}`}
        </p>

        {hasSeriesList && (
          <ol class="mt-3 space-y-1.5">
            {seriesArticles.map((entry, index) => (
              <li>
                <a
                  href={url(`/articles/${entry.id}/`)}
                  aria-current={entry.id === article.id ? 'page' : undefined}
                  class:list={[
                    'block text-xs leading-snug transition-colors',
                    entry.id === article.id
                      ? 'font-semibold text-ink'
                      : 'text-muted hover:text-accent',
                  ]}
                >
                  <span class="mr-1.5 tabular-nums text-[0.65rem]">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span lang={entry.data.language === 'kn' ? 'kn' : undefined}>{entry.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        )}

        <a
          href={url(`/series/${series.id}/`)}
          class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline"
        >
          View series <span aria-hidden="true">→</span>
        </a>
      </div>
    )}

    <div class="mt-8 border-t border-rule pt-6">
      <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-muted">Share</p>
      <button
        type="button"
        data-share-button
        data-share-title={article.data.title}
        data-share-url={shareUrl}
        class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-full border border-rule px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M12 15V4m0 0L8 8m4-4 4 4" />
          <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" />
        </svg>
        <span data-share-label>Share article</span>
      </button>
      <p class="sr-only" role="status" aria-live="polite" data-share-status></p>
    </div>

    <a href="#main" class="mt-8 inline-flex text-xs text-muted hover:text-accent">
      Back to top <span aria-hidden="true">↑</span>
    </a>
  </div>
</aside>
