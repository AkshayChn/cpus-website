---
import type { Article, Series } from '../../lib/content';
import { url } from '../../lib/url';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: Article;
  series?: Series;
  seriesArticles: Article[];
  toc: TocHeading[];
}

const { article, series, seriesArticles, toc } = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
const hasContents = toc.length > 0;
const hasSeries = Boolean(series && seriesArticles.length > 0);
const seriesIndex = seriesArticles.findIndex((entry) => entry.id === article.id);
const actionCount = (hasContents ? 1 : 0) + (hasSeries ? 1 : 0) + 1;
const gridClass =
  actionCount === 3 ? 'grid-cols-3' : actionCount === 2 ? 'grid-cols-2' : 'grid-cols-1';
---

<div class="no-print fixed inset-x-0 bottom-0 z-40 md:hidden" data-mobile-bar hidden>
  <div class="mx-auto max-w-md px-3 pb-[calc(env(safe-area-inset-bottom)+0.75rem)]">
    <div class="overflow-hidden rounded-2xl border border-rule bg-paper/95 shadow-lg backdrop-blur">
      <div class="h-0.5 bg-rule">
        <div class="h-full w-0 bg-accent" data-progress-bar></div>
      </div>
      <div class:list={['grid', gridClass]}>
        {hasContents && (
          <button
            type="button"
            data-sheet-open="contents"
            class="flex flex-col items-center justify-center gap-1 px-2 py-2.5 text-[0.65rem] font-medium text-muted transition-colors hover:text-accent"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h10" />
            </svg>
            <span>Contents</span>
          </button>
        )}

        {hasSeries && (
          <button
            type="button"
            data-sheet-open="series"
            class:list={[
              'flex flex-col items-center justify-center gap-1 px-2 py-2.5 text-[0.65rem] font-medium text-muted transition-colors hover:text-accent',
              hasContents && 'border-l border-rule',
            ]}
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v18H6.5A2.5 2.5 0 0 1 4 18.5v-13Z" />
              <path d="M4 17.5h16" />
            </svg>
            <span>Series</span>
          </button>
        )}

        <button
          type="button"
          data-share-button
          data-share-title={article.data.title}
          data-share-url={shareUrl}
          class:list={[
            'flex flex-col items-center justify-center gap-1 px-2 py-2.5 text-[0.65rem] font-medium text-muted transition-colors hover:text-accent',
            (hasContents || hasSeries) && 'border-l border-rule',
          ]}
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M12 15V4m0 0L8 8m4-4 4 4" />
            <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" />
          </svg>
          <span data-share-label>Share</span>
        </button>
      </div>
    </div>
  </div>
</div>

{hasContents && (
  <dialog
    class="sheet-dialog md:hidden"
    data-sheet="contents"
    aria-labelledby="sheet-contents-title"
  >
    <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-rule"></div>
    <div class="flex items-center justify-between gap-4">
      <h2 id="sheet-contents-title" class="text-base font-semibold text-ink">Contents</h2>
      <button
        type="button"
        data-sheet-close
        class="-mr-1 inline-flex size-10 items-center justify-center rounded-full text-muted hover:bg-accent-soft hover:text-ink"
      >
        <span class="sr-only">Close contents</span>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <ol class="mt-4 max-h-[62svh] space-y-1 overflow-y-auto overscroll-contain">
      {toc.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            data-toc-link={heading.slug}
            data-sheet-dismiss
            class:list={[
              'toc-link block border-l-2 border-transparent py-2 text-sm leading-snug text-muted hover:text-ink',
              heading.depth === 3 ? 'pl-6' : 'pl-3',
            ]}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </dialog>
)}

{series && hasSeries && (
  <dialog
    class="sheet-dialog md:hidden"
    data-sheet="series"
    aria-labelledby="sheet-series-title"
  >
    <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-rule"></div>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-muted">From the series</p>
        <h2 id="sheet-series-title" class="mt-1 text-base font-semibold leading-snug text-ink">
          {series.data.title}
        </h2>
        {seriesIndex >= 0 && (
          <p class="mt-1 text-xs text-muted">Part {seriesIndex + 1} of {seriesArticles.length}</p>
        )}
      </div>
      <button
        type="button"
        data-sheet-close
        class="-mr-1 inline-flex size-10 shrink-0 items-center justify-center rounded-full text-muted hover:bg-accent-soft hover:text-ink"
      >
        <span class="sr-only">Close series</span>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <ol class="mt-4 max-h-[55svh] space-y-1 overflow-y-auto overscroll-contain">
      {seriesArticles.map((entry, index) => (
        <li>
          <a
            href={url(`/articles/${entry.id}/`)}
            aria-current={entry.id === article.id ? 'page' : undefined}
            class:list={[
              'block rounded-lg px-2 py-2 text-sm leading-snug',
              entry.id === article.id
                ? 'bg-accent-soft font-semibold text-ink'
                : 'text-muted hover:bg-accent-soft hover:text-ink',
            ]}
          >
            <span class="mr-2 text-[0.65rem] tabular-nums text-muted">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span lang={entry.data.language === 'kn' ? 'kn' : undefined}>{entry.data.title}</span>
          </a>
        </li>
      ))}
    </ol>
    <a
      href={url(`/series/${series.id}/`)}
      class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline"
    >
      View series <span aria-hidden="true">→</span>
    </a>
  </dialog>
)}
